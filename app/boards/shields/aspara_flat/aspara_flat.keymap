#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys_jp_aliases.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

#define DEF 0
#define CUR 1
#define NUM 2
#define META 3

/ {
        macros {
        bt_0: bt_profile_macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                 &kp ESC     &kp F1    &kp F2    &kp F3    &kp F4    &kp DEL                &kp F5    &kp F6    &kp F7      &kp F8     &kp F9      &kp F10     &kp F11     &kp F12
    &kp C_NEXT   &kp JP_ZKHK &kp JP_1  &kp JP_2  &kp JP_3  &kp JP_4  &kp JP_5  &kp JP_6     &kp JP_7  &kp JP_8  &kp JP_9    &kp JP_0   &kp JP_MINS &kp JP_CIRC &kp JP_YEN  &kp BSPC 
    &kp C_PREV   &kp TAB     &kp JP_Q  &kp JP_W  &kp JP_E  &kp JP_R  &kp JP_T               &kp JP_Y  &kp JP_U  &kp JP_I    &kp JP_O   &kp JP_P    &kp JP_AT   &kp JP_LBRC
    &kp C_PLAY   &kp ENTER   &kp JP_A  &kp JP_S  &kp JP_D  &kp JP_F  &kp JP_G               &kp JP_H  &kp JP_J  &kp JP_K    &kp JP_L   &kp JP_SCLN &kp JP_COLN &kp JP_RBRC &kp ENTER
    &kp C_VOL_UP &kp LSHFT   &kp JP_Z  &kp JP_X  &kp JP_C  &kp JP_V  &kp JP_B               &kp JP_N  &kp JP_M  &kp JP_COMM &kp JP_DOT &kp JP_SLSH &kp JP_BSLS             &kp UP
    &kp C_VOL_DN &kp LCTRL   &kp LGUI  &kp LALT  &mo META  &mo NUM   &kp SPACE              &lt CUR SPACE &kp RALT  &kp RSHIFT  &kp RCTRL                         &kp LEFT &kp DOWN &kp RIGHT
            >;
        };

        cursol_layer{
            bindings = <
                 &trans      &trans    &trans    &trans    &trans    &trans                 &trans    &trans    &trans      &trans     &trans      &trans      &trans      &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans      &trans     &trans      &trans      &trans      &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans                 &trans    &kp HOME  &kp END     &trans     &kp PGUP    &trans      &trans
    &trans       &trans      &kp BSPC  &kp DEL   &trans    &trans    &trans                 &kp LEFT  &kp UP    &kp DOWN    &kp RIGHT  &kp PGDN    &trans      &trans      &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans                 &trans    &trans    &trans      &trans     &trans      &trans                  &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans                 &trans    &trans    &trans      &trans                                  &trans &trans &trans
            >;
        };

        num_layer{
            bindings = <
                 &trans      &trans    &trans    &trans    &trans    &kp KP_NUMLOCK         &trans    &trans     &trans     &trans      &trans     &trans      &trans      &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans    &trans       &trans    &trans     &trans     &kp KP_MINUS &trans    &trans      &trans      &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans                 &kp JP_7  &kp JP_8   &kp JP_9   &trans      &trans     &trans      &trans
    &trans       &kp CAPS    &trans    &trans    &trans    &trans    &trans                 &kp JP_4  &kp JP_5   &kp JP_6   &trans      &kp KP_PLUS &kp KP_ASTERISK &trans  &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans                 &kp JP_1  &kp JP_2   &kp JP_3   &trans      &kp KP_SLASH &trans                 &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans                 &kp JP_0  &kp KP_DOT &trans     &trans                                   &trans &trans &trans
            >;
        };

        meta_layer {
            bindings = <
                 &bt BT_CLR  &trans    &trans    &trans    &trans    &bootloader            &trans    &trans    &trans      &trans     &trans      &trans      &trans      &bootloader
    &trans       &out OUT_TOG &bt_0    &bt_1     &bt_2     &trans    &trans    &trans       &trans    &trans    &trans      &trans     &trans      &trans      &trans      &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans                 &trans    &trans    &trans      &trans     &trans      &trans      &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans                 &trans    &trans    &trans      &trans     &trans      &trans      &trans      &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans                 &trans    &trans    &trans      &trans     &trans      &trans                  &trans
    &trans       &trans      &trans    &trans    &trans    &trans    &trans                 &trans    &trans    &trans      &trans                                  &trans &trans &trans
            >;
        };

        reserve_layer{
            bindings = <
                        &trans &out OUT_USB &out OUT_BLE &out OUT_TOG &trans       &trans       &trans &trans &trans &trans &trans &trans &trans &trans
                &trans  &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &trans &trans &trans &trans &trans  &bt BT_CLR
                &trans  &trans &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans &trans &trans
                &trans  &trans &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans &trans &trans &trans
                &trans  &trans &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans &trans          &trans
                &trans  &trans &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans                 &trans &trans &trans
            >;
        };
    };
};
